# ---- 复制为 .env 后按需修改 ----
POSTGRES_USER=report
POSTGRES_PASSWORD=report
POSTGRES_DB=smartreportgen
PG_HOST_PORT=55433

# 数据源密码加密密钥（务必修改并妥善保管；变更后已保存的数据源密码需重新填写）
SECRET_KEY=change-me-to-a-long-random-string
# ---- 海尔 IAM 单点登录与 HTTP / MCP 访问认证 ----
HAIER_IAM_HOST=https://iama.haier.net
HAIER_IAM_CLIENT_ID=
HAIER_IAM_CLIENT_SECRET=
HAIER_IAM_SCOPE=read
# 需在 IAM 应用中登记的回调地址；留空 = ${PUBLIC_BASE_URL}/auth/iam/callback
IAM_REDIRECT_URI=
# 浏览器访问 IAM 的地址与服务端不同时才填（如经内网代理访问 IAM）
HAIER_IAM_AUTHORIZE_HOST=
# 首批管理员工号（逗号分隔）：首次经 IAM 登录管理台时成为管理员（经 MCP 自动注册的一律为普通用户）
IAM_BOOTSTRAP_ADMINS=
# 员工首次调用 MCP 或首次登录时自动注册为普通用户（无权限，待授权）；DEFAULT_USER_ROLE 为其默认角色
IAM_AUTO_REGISTER=true
DEFAULT_USER_ROLE=user
# IAM 核实结果缓存秒数。设为 0 可逐次核验。
IAM_TOKEN_CACHE_SECONDS=300
# 管理台浏览器会话最长小时数
SESSION_HOURS=12

# 管理台、IAM 回调和 MCP 共用此入口
API_BIND=127.0.0.1
API_HOST_PORT=18600
PUBLIC_BASE_URL=http://localhost:18600
# 留空时使用 ${PUBLIC_BASE_URL}/mcp
MCP_PUBLIC_URL=

# ---- 向量化（混合检索中的语义部分）----
# hash：内置离线哈希向量，零依赖但无语义能力，仅用于演示/兜底
# openai：任意 OpenAI 兼容 /embeddings 接口，例如：
#   Ollama:     EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1  EMBEDDING_MODEL=bge-m3  EMBEDDING_DIM=1024
#   DashScope:  EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  EMBEDDING_MODEL=text-embedding-v3  EMBEDDING_DIM=1024
#   OpenAI:     EMBEDDING_BASE_URL=https://api.openai.com/v1  EMBEDDING_MODEL=text-embedding-3-small  EMBEDDING_DIM=1536
#   AI 网关:    AI_BASE_URL / AI_API_KEY 与 EMBEDDING_BASE_URL / EMBEDDING_API_KEY 等价（后者优先）
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
AI_BASE_URL=
AI_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
# 模型支持 dimensions 参数时可设为 true（如 Qwen3-Embedding 原生 2560 维，截断到 1024 以便使用 HNSW 索引）
EMBEDDING_SEND_DIMENSIONS=false
# 指令式向量模型的查询前缀（\n 表示换行），例如 Qwen3-Embedding：
# EMBEDDING_QUERY_INSTRUCTION=Instruct: 根据用户的数据分析需求，检索最匹配的业务场景数据集\nQuery: 
EMBEDDING_QUERY_INSTRUCTION=

QUERY_MAX_ROWS=50000
QUERY_TIMEOUT_SECONDS=60
# 数据库字段元数据缓存秒数；0 禁用，不缓存业务查询结果。
SCHEMA_CACHE_SECONDS=300
# 首次启动写入演示数据源/数据集/样式规则
SEED_DEMO=true
DEMO_READER_PASSWORD=demo_reader_pwd
