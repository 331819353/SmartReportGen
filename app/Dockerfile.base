# 预制构建与运行底座镜像（固化 python + binutils / chromium + fonts-noto-cjk）。
# 仅在首次初始化或需要升级系统包 / Chromium / Python 基础镜像时构建；
# 日常发版通过 scripts/local-cache.sh 直接复用本地已保存的底座镜像。
ARG PYTHON_IMAGE=python:3.12-slim

FROM ${PYTHON_IMAGE} AS builder-base
ARG APT_MIRROR=
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /srv
RUN if [ -n "${APT_MIRROR}" ]; then \
        mirror="${APT_MIRROR#http://}"; mirror="${mirror#https://}"; mirror="${mirror%/}"; \
        sed -i "s|deb.debian.org|${mirror}|g" /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list 2>/dev/null || true; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends binutils \
    && rm -rf /var/lib/apt/lists/*

FROM ${PYTHON_IMAGE} AS runtime-base
ARG APT_MIRROR=
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /srv
# 保留完整 Chromium 和中日韩字体用于桌面、窄屏及离线报告验收。
RUN if [ -n "${APT_MIRROR}" ]; then \
        mirror="${APT_MIRROR#http://}"; mirror="${mirror#https://}"; mirror="${mirror%/}"; \
        sed -i "s|deb.debian.org|${mirror}|g" /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list 2>/dev/null || true; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends chromium fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
